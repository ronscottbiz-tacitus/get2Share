rules_version = '2';

// Get2Share security rules: many events, each sealed off from the others.
// Version 2026-10-06: guests' Loved photos follow them ("loved").
//
// Who is who:
//   * Every device signs in with Firebase Auth. Guests and Share Spots get a
//     silent anonymous account; its uid is their ID everywhere.
//   * Hosts sign in with Google. Anyone signed in with Google can create an
//     event and becomes its owner/host. The owner can add co-hosts.
//   * Admins (adminEmails) can help with any event. Keep in sync with src/hosts.ts.
//
// Layout:
//   events/{eventId}                  name, hosts, join code, settings
//     members/{uid}                   who joined (guests and Share Spots)
//     photos/{photoId}
//     sessions/{uid}                  live device state (camera sharing, Share Spots)
//     live/console                    "the Host Console is watching"
//   joinCodes/{CODE}                  CODE → eventId, so a link or code finds its event
//   spotPairings/{CODE}               one-time Share Spot codes, tied to one event
//   screenPairings/{CODE}             codes a TV shows; a host claims one to add that TV
//   events/{eventId}/screens/{tvUid}  per-TV settings (layout, QR, pause) the hosts control
//
// What this enforces:
//   * You only see an event's photos if you joined it (with its current join
//     code) or host it. Knowing another event's name or ID gets you nothing.
//   * Only that event's hosts moderate, change settings, see devices and
//     previews, ask for cameras, fire shutters, or add Share Spots and screens.
//   * A guest photo goes live immediately only if auto-approval is on, or a host
//     fired that device's shutter in the last 2 minutes. Otherwise 'pending'.
//   * Guests can delete only their own photos.
//   * Events end: an hour after the end time no new photos can be added. The
//     album stays viewable until expireAt (end + 30 days), when Firestore's TTL
//     cleanup deletes every document carrying that expireAt.
//   * users/{uid}/joined lists the events a device joined, so a guest who saves
//     their photos (links a Google account) keeps them on any device.

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny for anything not matched below.
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- Identity ----------

    function adminEmails() {
      return ['ronaldscott.ca@gmail.com', 'ronscottbiz@gmail.com'];
    }

    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    // Signed in with a real account (Google etc.), not an anonymous guest.
    function hasAccount() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.get('email_verified', false) == true;
    }

    function isAdmin() {
      return hasAccount() && request.auth.token.get('email', '').lower() in adminEmails();
    }

    function isOwner(uid) {
      return signedIn() && myUid() == uid;
    }

    // ---------- Helpers ----------

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function changed() {
      return incoming().diff(existing()).affectedKeys();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isCode(code) {
      return code is string && code.matches('^[A-Z0-9]{6}$');
    }

    function eventPath(eid) {
      return /databases/$(database)/documents/events/$(eid);
    }

    function eventData(eid) {
      return get(eventPath(eid)).data;
    }

    function joinCodePath(code) {
      return /databases/$(database)/documents/joinCodes/$(code);
    }

    function pairingPath(code) {
      return /databases/$(database)/documents/spotPairings/$(code);
    }

    function memberPath(eid, uid) {
      return /databases/$(database)/documents/events/$(eid)/members/$(uid);
    }

    function isEventHost(eid) {
      return signedIn()
        && (isAdmin() || (exists(eventPath(eid)) && myUid() in eventData(eid).hostUids));
    }

    function isMember(eid) {
      return signedIn() && exists(memberPath(eid, myUid()));
    }

    // Joined the event, or hosts it.
    function canSee(eid) {
      return isMember(eid) || isEventHost(eid);
    }

    // ---------- Events ----------

    function eventKeys() {
      return ['name', 'subtitle', 'ownerUid', 'hostUids', 'joinCode', 'access',
              'autoApproval', 'guestLensEnabled', 'status', 'createdAt', 'startsAt', 'endsAt', 'expireAt',
              'groupShot'];
    }

    function albumDays() {
      return duration.value(30, 'd');
    }

    // An end time always comes with its cleanup date, 30 days later.
    function endsLineUp(d) {
      return (!('endsAt' in d) || d.endsAt == null)
        ? (!('expireAt' in d) || d.expireAt == null)
        : (d.endsAt is timestamp && 'expireAt' in d && d.expireAt == d.endsAt + albumDays());
    }

    function hasEnd(e) {
      return 'endsAt' in e && e.endsAt is timestamp;
    }

    // New photos are accepted until an hour after the end time.
    function uploadsOpen(eid) {
      let e = eventData(eid);
      return !hasEnd(e) || request.time < e.endsAt + duration.value(1, 'h');
    }

    // People can join (and see the album) until the cleanup date.
    function joinOpen(e) {
      return !hasEnd(e) || request.time < e.expireAt;
    }

    function isOptionalTime(d, key) {
      return !(key in d) || d[key] == null || d[key] is timestamp;
    }

    function isValidEvent(d) {
      return d.keys().hasOnly(eventKeys())
        && d.keys().hasAll(['name', 'ownerUid', 'hostUids', 'joinCode', 'access',
                            'autoApproval', 'guestLensEnabled', 'status', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && (!('subtitle' in d) || (d.subtitle is string && d.subtitle.size() <= 200))
        && d.ownerUid is string
        && d.hostUids is list && d.hostUids.size() >= 1 && d.hostUids.size() <= 10
        && d.ownerUid in d.hostUids
        && isCode(d.joinCode)
        && d.access in ['link', 'list']
        && d.autoApproval is bool
        && d.guestLensEnabled is bool
        && d.status in ['live', 'wrapup', 'album', 'archived']
        && isOptionalTime(d, 'startsAt')
        && isOptionalTime(d, 'endsAt')
        && isOptionalTime(d, 'expireAt')
        && endsLineUp(d)
        && (!('groupShot' in d) || d.groupShot == null || isValidGroupShot(d.groupShot));
    }

    // A Group Shot: every guest camera that opted in fires at firesAt.
    function isValidGroupShot(g) {
      return g is map
        && g.keys().hasOnly(['id', 'firesAt', 'by', 'spots'])
        && (!('spots' in g) || g.spots is bool)
        && g.id is string && g.id.size() > 0 && g.id.size() <= 40
        && g.firesAt is timestamp
        && g.by is string && g.by.size() <= 128;
    }

    match /events/{eid} {
      allow get: if canSee(eid);
      // "My events": a host lists the events they host.
      allow list: if hasAccount() && (isAdmin() || myUid() in resource.data.hostUids);

      // Anyone with an account can create an event; they become its owner and host.
      // The event and its join code are written together.
      allow create: if hasAccount()
                    && isValidId(eid)
                    && isValidEvent(incoming())
                    && incoming().ownerUid == myUid()
                    && incoming().hostUids == [myUid()]
                    && incoming().createdAt == request.time
                    && incoming().status == 'live'
                    && getAfter(joinCodePath(incoming().joinCode)).data.eventId == eid;

      allow update: if isEventHost(eid)
                    && isValidEvent(incoming())
                    && changed().hasOnly(['name', 'subtitle', 'joinCode', 'access', 'autoApproval',
                                          'guestLensEnabled', 'status', 'startsAt', 'endsAt', 'expireAt', 'hostUids',
                                          'groupShot'])
                    && incoming().ownerUid == existing().ownerUid
                    // Only the owner (or an admin) changes who the hosts are.
                    && (!('hostUids' in changed()) || existing().ownerUid == myUid() || isAdmin())
                    // A new join code must point back at this event.
                    && (!('joinCode' in changed())
                        || getAfter(joinCodePath(incoming().joinCode)).data.eventId == eid);

      allow delete: if isAdmin() || (signedIn() && existing().ownerUid == myUid());
    }

    // ---------- Join codes ----------

    match /joinCodes/{code} {
      // Looking up one code is how a link finds its event. No browsing the list.
      allow get: if signedIn();
      allow list: if false;

      allow create: if hasAccount()
                    && isCode(code)
                    && incoming().keys().hasOnly(['eventId', 'name', 'expireAt'])
                    && isOptionalTime(incoming(), 'expireAt')
                    && incoming().eventId is string
                    && incoming().name is string && incoming().name.size() <= 80
                    && getAfter(eventPath(incoming().eventId)).data.joinCode == code
                    && (isAdmin() || myUid() in getAfter(eventPath(incoming().eventId)).data.hostUids);

      allow update: if isEventHost(existing().eventId)
                    && changed().hasOnly(['name', 'expireAt'])
                    && incoming().name is string && incoming().name.size() <= 80
                    && isOptionalTime(incoming(), 'expireAt');

      allow delete: if isEventHost(existing().eventId);
    }

    // ---------- Members ----------

    // A Share Spot joins with the one-time code the host made for this event.
    function spotPairedTo(eid, code, uid) {
      return isCode(code)
        && exists(pairingPath(code))
        && get(pairingPath(code)).data.claimedBy == uid
        && get(pairingPath(code)).data.eventId == eid;
    }

    // A TV joins after a host of this event claimed the code it showed.
    function screenPairedTo(eid, code, uid) {
      return isCode(code)
        && exists(screenPairingPath(code))
        && get(screenPairingPath(code)).data.screenUid == uid
        && get(screenPairingPath(code)).data.eventId == eid;
    }

    function screenPairingPath(code) {
      return /databases/$(database)/documents/screenPairings/$(code);
    }

    match /events/{eid}/members/{mid} {
      allow get: if isOwner(mid) || isEventHost(eid);
      allow list: if isEventHost(eid);

      allow create: if isOwner(mid)
                    && incoming().keys().hasOnly(['nickname', 'joinedAt', 'joinCode', 'role', 'expireAt'])
                    && incoming().keys().hasAll(['nickname', 'joinedAt', 'joinCode', 'role'])
                    && isOptionalTime(incoming(), 'expireAt')
                    && incoming().nickname is string
                    && incoming().nickname.size() > 0 && incoming().nickname.size() <= 40
                    && incoming().joinedAt == request.time
                    && (
                      // Guests: the event is open to anyone with the link, and they have its current code.
                      (incoming().role == 'guest'
                        && exists(eventPath(eid))
                        && eventData(eid).access == 'link'
                        && eventData(eid).status == 'live'
                        && joinOpen(eventData(eid))
                        && incoming().joinCode == eventData(eid).joinCode)
                      // Share Spots: they claimed a pairing code the host made for this event.
                      || (incoming().role == 'spot' && spotPairedTo(eid, incoming().joinCode, mid))
                      // TV screens: a host claimed the code this TV showed.
                      || (incoming().role == 'screen' && screenPairedTo(eid, incoming().joinCode, mid))
                    );

      // Guests can rename themselves, keep Share Spot photos ("Scan to keep this one")
      // and remember the photos they loved.
      allow update: if isOwner(mid)
                    && changed().hasOnly(['nickname', 'kept', 'loved'])
                    && incoming().nickname is string
                    && incoming().nickname.size() > 0 && incoming().nickname.size() <= 40
                    && (!('kept' in incoming()) || (incoming().kept is list && incoming().kept.size() <= 300))
                    && (!('loved' in incoming()) || (incoming().loved is list && incoming().loved.size() <= 500));

      allow delete: if isOwner(mid) || isEventHost(eid);
    }

    // ---------- Event presence ----------

    // The Host Console says "I'm watching" (and which Share Spot is focused) so
    // Share Spots only send preview frames when someone is looking.
    match /events/{eid}/live/{docId} {
      allow read: if canSee(eid);
      allow write: if isEventHost(eid)
                   && docId == 'console'
                   && incoming().keys().hasOnly(['watching', 'focusSpot', 'heartbeatAt'])
                   && incoming().watching is bool
                   && (incoming().focusSpot == null
                       || (incoming().focusSpot is string && incoming().focusSpot.size() <= 128))
                   && incoming().heartbeatAt == request.time;
    }

    // ---------- Photos ----------

    function photoKeys() {
      return ['url', 'nickname', 'sessionId', 'createdAt', 'status', 'reactions', 'flagged'];
    }

    function isValidReactions(r) {
      return r is map
        && r.keys().hasOnly(['likes', 'dislikes'])
        && r.likes is int && r.likes >= 0
        && r.dislikes is int && r.dislikes >= 0;
    }

    function isValidPhoto(data) {
      return data.keys().hasAll(photoKeys())
        && data.keys().hasOnly(photoKeys().concat(['expireAt']))
        && isOptionalTime(data, 'expireAt')
        && data.url is string && data.url.size() > 0 && data.url.size() <= 1000000
        && data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 64
        && data.sessionId is string && data.sessionId.size() <= 128
        && data.createdAt is int
        && data.status in ['pending', 'approved', 'rejected']
        && isValidReactions(data.reactions)
        && data.flagged is bool;
    }

    // Each like/dislike count may move by at most one per write.
    function isSingleReactionChange() {
      return math.abs(incoming().reactions.likes - existing().reactions.likes) <= 1
        && math.abs(incoming().reactions.dislikes - existing().reactions.dislikes) <= 1;
    }

    // True if a host fired this device's shutter within the last 2 minutes.
    function hostTriggeredRecently(eid) {
      let path = /databases/$(database)/documents/events/$(eid)/sessions/$(myUid());
      let t = exists(path) ? get(path).data.get('last_trigger_at', null) : null;
      return t is timestamp && request.time < t + duration.value(2, 'm');
    }

    // A Group Shot photo: from a minute before the cameras fire to two minutes after.
    function groupShotRecently(eid) {
      let g = eventData(eid).get('groupShot', null);
      return g is map && g.firesAt is timestamp
        && request.time > g.firesAt - duration.value(1, 'm')
        && request.time < g.firesAt + duration.value(2, 'm')
        && incoming().nickname.matches('.* [(]Group Shot[)]$');
    }

    match /events/{eid}/photos/{photoId} {
      // Members see approved photos. Pending/rejected ones only the hosts and the uploader.
      allow get, list: if canSee(eid)
                       && (existing().status == 'approved'
                           || isEventHost(eid)
                           || isOwner(existing().sessionId));

      allow create: if isValidId(photoId)
                    && isValidPhoto(incoming())
                    && (
                      // Admin: bringing over photos from before events existed.
                      isAdmin()
                      || (canSee(eid)
                          && uploadsOpen(eid)
                          && incoming().sessionId == myUid()
                          && incoming().reactions.likes == 0
                          && incoming().reactions.dislikes == 0
                          && incoming().flagged == false
                          && (incoming().status == 'pending'
                              || (incoming().status == 'approved'
                                  && (isEventHost(eid)
                                      || eventData(eid).autoApproval == true
                                      || hostTriggeredRecently(eid)
                                      || groupShotRecently(eid)))))
                    );

      allow update: if isValidPhoto(incoming())
                    && (
                      (isEventHost(eid) && changed().hasOnly(['status', 'flagged']))
                      || (canSee(eid)
                          && existing().status == 'approved'
                          && changed().hasOnly(['reactions'])
                          && isSingleReactionChange())
                      || (canSee(eid)
                          && existing().status == 'approved'
                          && changed().hasOnly(['flagged'])
                          && incoming().flagged == true)
                    );

      allow delete: if isEventHost(eid) || isOwner(existing().sessionId);
    }

    // ---------- Sessions (guest cameras, Share Spots) ----------

    function sessionKeys() {
      return ['sessionId', 'nickname', 'role', 'lastActive', 'deviceInfo',
              'lens_status', 'stream_frame', 'invited_to_lens', 'trigger_shutter',
              'last_trigger_at', 'invited_by', 'pairing_code', 'expireAt'];
    }

    function isValidSession(data, sid) {
      return data.keys().hasAll(['sessionId', 'nickname', 'role', 'lastActive'])
        && data.keys().hasOnly(sessionKeys())
        && data.sessionId == sid
        && data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 64
        && data.role in ['guest', 'tripod', 'host']
        && data.lastActive is int
        && (!('deviceInfo' in data) || data.deviceInfo is map)
        && (!('lens_status' in data) || data.lens_status in ['off', 'requesting', 'streaming', 'declined'])
        && (!('stream_frame' in data) || data.stream_frame == null
            || (data.stream_frame is string && data.stream_frame.size() <= 300000))
        && (!('invited_to_lens' in data) || data.invited_to_lens is bool)
        && (!('trigger_shutter' in data) || data.trigger_shutter is bool)
        && (!('invited_by' in data) || data.invited_by is string)
        && (!('last_trigger_at' in data) || data.last_trigger_at is timestamp)
        && (!('pairing_code' in data) || isCode(data.pairing_code))
        && isOptionalTime(data, 'expireAt');
    }

    // A Share Spot ('tripod') must point at a pairing code it claimed for this event.
    // Checked only when a device becomes a Share Spot, not on every preview frame.
    function roleAllowed(eid, sid) {
      return incoming().role == 'guest'
        || (incoming().role == 'tripod' && spotPairedTo(eid, incoming().get('pairing_code', ''), sid));
    }

    // A device may turn these off on itself, but only a host can turn them on.
    function onlyHostCanEnable(field) {
      return incoming().get(field, false) == false
        || incoming().get(field, false) == existing().get(field, false);
    }

    match /events/{eid}/sessions/{sid} {
      // Sessions include live camera previews: only hosts and the device itself.
      allow get: if isEventHost(eid) || isOwner(sid);
      allow list: if isEventHost(eid);

      allow create: if isOwner(sid)
                    && isValidId(sid)
                    && isMember(eid)
                    && isValidSession(incoming(), sid)
                    && roleAllowed(eid, sid)
                    && incoming().get('invited_to_lens', false) == false
                    && incoming().get('trigger_shutter', false) == false
                    && incoming().get('lens_status', 'off') != 'requesting'
                    && !('last_trigger_at' in incoming())
                    && !('invited_by' in incoming());

      allow update: if isValidSession(incoming(), sid)
                    && (
                      // The device updating itself (heartbeat, battery, preview frames,
                      // accepting/declining a camera request, clearing a fired shutter).
                      (isOwner(sid)
                        && ((incoming().role == existing().role
                             && incoming().get('pairing_code', null) == existing().get('pairing_code', null))
                            || roleAllowed(eid, sid))
                        && onlyHostCanEnable('invited_to_lens')
                        && onlyHostCanEnable('trigger_shutter')
                        && (incoming().get('lens_status', 'off') != 'requesting'
                            || existing().get('lens_status', 'off') == 'requesting')
                        && incoming().get('last_trigger_at', null) == existing().get('last_trigger_at', null)
                        && incoming().get('invited_by', null) == existing().get('invited_by', null))
                      // A host asking for a camera, cancelling it, or firing a shutter.
                      || (isEventHost(eid)
                        && changed().hasOnly(['invited_to_lens', 'lens_status', 'stream_frame',
                                              'trigger_shutter', 'last_trigger_at', 'invited_by'])
                        && (!('last_trigger_at' in changed()) || incoming().last_trigger_at == request.time))
                    );

      allow delete: if isEventHost(eid) || isOwner(sid);
    }

    // ---------- Share Spot pairing codes ----------

    match /spotPairings/{code} {
      // A host sees their event's codes; a Share Spot can read the one it claimed.
      allow get: if (signedIn() && existing().claimedBy == myUid()) || isEventHost(existing().eventId);
      allow list: if isAdmin();

      allow create: if isCode(code)
                    && incoming().keys().hasOnly(['spotName', 'createdAt', 'claimedBy', 'eventId', 'expireAt'])
                    && isOptionalTime(incoming(), 'expireAt')
                    && incoming().keys().hasAll(['spotName', 'createdAt', 'claimedBy', 'eventId'])
                    && incoming().eventId is string
                    && isEventHost(incoming().eventId)
                    && incoming().spotName is string
                    && incoming().spotName.size() > 0 && incoming().spotName.size() <= 30
                    && incoming().createdAt == request.time
                    && incoming().claimedBy == null;

      // A device claims an unclaimed, unexpired code for itself. Once only.
      allow update: if signedIn()
                    && existing().claimedBy == null
                    && request.time < existing().createdAt + duration.value(10, 'm')
                    && changed().hasOnly(['claimedBy', 'claimedAt'])
                    && incoming().claimedBy == myUid()
                    && incoming().claimedAt == request.time;

      // Deleting a code (cancel, or removing the Share Spot) stops that device
      // from registering as a Share Spot again.
      allow delete: if isEventHost(existing().eventId);
    }

    // ---------- TV screens ----------

    match /screenPairings/{code} {
      // Codes are random and short-lived; reading one only says which TV and event.
      allow get: if signedIn();
      allow list: if false;

      // The TV makes its own code.
      allow create: if signedIn()
                    && isCode(code)
                    && incoming().keys().hasOnly(['screenUid', 'createdAt', 'eventId', 'screenName', 'claimedBy'])
                    && incoming().screenUid == myUid()
                    && incoming().createdAt == request.time
                    && incoming().eventId == null
                    && incoming().screenName == null
                    && incoming().claimedBy == null;

      // A host claims it for one of their events, once, within 15 minutes.
      allow update: if signedIn()
                    && existing().claimedBy == null
                    && request.time < existing().createdAt + duration.value(15, 'm')
                    && changed().hasOnly(['eventId', 'claimedBy', 'screenName', 'claimedAt'])
                    && incoming().claimedBy == myUid()
                    && incoming().claimedAt == request.time
                    && incoming().eventId is string
                    && isEventHost(incoming().eventId)
                    && incoming().screenName is string
                    && incoming().screenName.size() > 0 && incoming().screenName.size() <= 40;

      allow delete: if signedIn()
                    && (existing().screenUid == myUid()
                        || (existing().eventId is string && isEventHost(existing().eventId)));
    }

    function isValidScreen(d) {
      return d.keys().hasOnly(['name', 'layout', 'showQr', 'showNames', 'paused', 'pairingCode', 'lastSeen'])
        && d.keys().hasAll(['name', 'layout', 'showQr', 'showNames', 'paused', 'pairingCode'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.layout in ['wall', 'justin', 'slideshow']
        && d.showQr is bool && d.showNames is bool && d.paused is bool
        && isCode(d.pairingCode)
        && isOptionalTime(d, 'lastSeen');
    }

    match /events/{eid}/screens/{sid} {
      allow get, list: if isEventHost(eid) || isOwner(sid);
      allow create: if isEventHost(eid) && isValidScreen(incoming());
      allow update: if isValidScreen(incoming())
                    && (
                      isEventHost(eid)
                      // The TV only checks in ("still on").
                      || (isOwner(sid) && changed().hasOnly(['lastSeen']) && incoming().lastSeen == request.time)
                    );
      allow delete: if isEventHost(eid) || isOwner(sid);
    }

    // ---------- Events a device joined ----------

    match /users/{uid}/joined/{eid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
                            && isValidId(eid)
                            && incoming().keys().hasOnly(['name', 'code', 'joinedAt', 'expireAt'])
                            && incoming().name is string && incoming().name.size() <= 80
                            && isCode(incoming().code)
                            && incoming().joinedAt == request.time
                            && isOptionalTime(incoming(), 'expireAt')
                            && exists(memberPath(eid, uid));
    }

    // ---------- From before events existed (admin only, for bringing photos over) ----------

    match /photos/{photoId} {
      allow read, delete: if isAdmin();
    }

    match /sessions/{sid} {
      allow read, delete: if isAdmin();
    }

    match /settings/{settingsId} {
      allow read: if isAdmin();
    }
  }
}
