rules_version = '2';

// Get2Share photo storage.
//   * Photos live under events/<eventId>/<uploader uid>/. A device uploads only into its own
//     folder, only for an event it has joined (or hosts), images only, under 5 MB.
//   * Reading a file through the SDK (which is how the uploader gets the photo's download link)
//     is for the uploader, the event's hosts and admins. Everyone else views photos through the
//     download link stored on the photo, which these rules don't gate. Nobody can list a folder.
//   * The uploader, the event's hosts, or an admin can delete a photo's file
//     (deleting a photo in the app deletes its file too).
//   * photos/<uid>/ is the older layout from before events existed: no new uploads, and the
//     uploader or an admin can still delete.
//   * moments/ and walkthroughs/ are written only by the cloud jobs, so nothing here opens them.
//
// The member and host checks read Firestore. The first time you publish this, Firebase asks to
// let Storage rules read Firestore: allow it. Tests: tests/rules/storage.test.mjs.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '').lower() in ['ronaldscott.ca@gmail.com', 'ronscottbiz@gmail.com'];
    }

    function eventPath(eventId) {
      return /databases/(default)/documents/events/$(eventId);
    }

    // The event's owner or a co-host. False when the event doesn't exist.
    function isHost(eventId) {
      return signedIn()
        && firestore.exists(eventPath(eventId))
        && (request.auth.uid == firestore.get(eventPath(eventId)).data.ownerUid
            || request.auth.uid in firestore.get(eventPath(eventId)).data.get('hostUids', []));
    }

    // Joined the event: a guest, a Share Spot or a TV. A removed guest's member doc is gone.
    function isMember(eventId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/events/$(eventId)/members/$(request.auth.uid));
    }

    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /events/{eventId}/{uid}/{fileName} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin() || isHost(eventId));
      allow list: if false;
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && isValidImage()
                    && (isMember(eventId) || isHost(eventId) || isAdmin());
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin() || isHost(eventId));
    }

    match /photos/{uid}/{fileName} {
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }
  }
}
