{
  "entities": {
    "Photo": {
      "title": "Photo",
      "description": "An event snap/photo uploaded by a guest or tripod node",
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "The URL of the photo asset"
        },
        "nickname": {
          "type": "string",
          "description": "The nickname of the uploader"
        },
        "sessionId": {
          "type": "string",
          "description": "The unique guest session UUID"
        },
        "createdAt": {
          "type": "number",
          "description": "UTC milliseconds epoch of creation"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Moderation review status"
        },
        "reactions": {
          "type": "object",
          "description": "Like/dislike interaction counts"
        },
        "flagged": {
          "type": "boolean",
          "description": "Flag indicating safe content status"
        }
      },
      "required": ["url", "nickname", "sessionId", "createdAt", "status", "reactions", "flagged"]
    },
    "GuestSession": {
      "title": "GuestSession",
      "description": "A live device/session connected to the event",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "Session UUID"
        },
        "nickname": {
          "type": "string",
          "description": "Session display nickname"
        },
        "lastActive": {
          "type": "number",
          "description": "Heartbeat timestamp"
        },
        "role": {
          "type": "string",
          "enum": ["guest", "tripod", "host"],
          "description": "User role at the event"
        },
        "deviceInfo": {
          "type": "object",
          "description": "Device metadata details"
        },
        "invited_to_lens": {
          "type": "boolean",
          "description": "Lens handshake invitation active"
        },
        "lens_status": {
          "type": "string",
          "enum": ["off", "requesting", "streaming", "declined"],
          "description": "Lens active state"
        },
        "stream_frame": {
          "type": "string",
          "description": "Base64 thumbnail frame of streaming feed"
        },
        "trigger_shutter": {
          "type": "boolean",
          "description": "Shutter remote command status"
        }
      },
      "required": ["sessionId", "nickname", "role", "lastActive"]
    },
    "EventSettings": {
      "title": "EventSettings",
      "description": "Global event moderation and metadata configuration",
      "type": "object",
      "properties": {
        "autoApproval": {
          "type": "boolean",
          "description": "Whether snaps publish without host preview"
        },
        "eventTitle": {
          "type": "string",
          "description": "Custom name/title of the event"
        },
        "eventSubtitle": {
          "type": "string",
          "description": "Welcome message or announcement subtitle"
        },
        "guestLensEnabled": {
          "type": "boolean",
          "description": "Global toggle allowing guest lens requests"
        }
      },
      "required": ["autoApproval"]
    }
  },
  "firestore": {
    "/photos/{photoId}": {
      "schema": "Photo",
      "description": "Collection of uploaded photos"
    },
    "/sessions/{sessionId}": {
      "schema": "GuestSession",
      "description": "Collection of guest and tripod device heartbeats"
    },
    "/settings/{settingsId}": {
      "schema": "EventSettings",
      "description": "Collection of global configuration settings"
    }
  }
}
